session_data/

# run logs (see _configure_logging / logfile_prefix)
logs/
*.log

# output/ review artifacts are regenerated by every run and must never be
# version-controlled directly (they were briefly committed by mistake, which
# broke CI `git pull`s in a long-lived checkout). martinez_flags.csv,
# dms_mrz_elev_2013_9999.csv, and dms_mrz_elev_filled.csv stay DVC-tracked
# (see output/.gitignore, auto-managed by `dvc add`) -- do not add them here.
output/martinez_intervals.csv
